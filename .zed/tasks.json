[
  {
    "label": "build",
    "command": "cmake --build build",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "no_focus",
    "reveal_target": "dock",
    "hide": "on_success",
    "shell": "system",
    "show_summary": true,
    "show_command": true,
    "save": "none",
  },
  {
    "label": "configure",
    "command": "cmake -B build -DDUSKLIGHT_DIR=../dusklight",
    "env": { "CMAKE_EXPORT_COMPILE_COMMANDS": "1" },
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "no_focus",
    "reveal_target": "dock",
    "hide": "on_success",
    "shell": "system",
    "show_summary": true,
    "show_command": true,
    "save": "none",
  },
]
